{
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        {
            "src": "^/assets/?$",
            "dest": "/404.html",
            "status": 404,
            "override": true
        },
        {
            "src": "^/images/?$",
            "dest": "/404.html",
            "status": 404,
            "override": true
        }
    ]
}
